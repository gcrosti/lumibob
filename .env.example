# Alpaca API credentials
# Sign up at https://alpaca.markets and generate keys from the dashboard.
# Use paper trading keys while RUN_MODE=backtest or RUN_MODE=paper.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_IS_PAPER=true

# PostgreSQL + TimescaleDB connection string
# Default matches the docker-compose.yml service.
# For a managed cloud instance (Timescale Cloud, Supabase, etc.) replace this
# value — no code changes are needed.
DB_URL=postgresql://postgres:lumibob@localhost:5432/lumibob

# Execution mode
# backtest — runs a historical simulation via Lumibot's YahooDataBacktesting engine
# paper    — connects to Alpaca paper trading and runs the strategy live
RUN_MODE=backtest
